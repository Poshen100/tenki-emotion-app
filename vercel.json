{
    "outputDirectory": ".",
    "framework": null,
    "headers": [
        {
            "source": "/preview/(finger-ppg-test.html|finger-ppg.js|finger-edge.js|engine-bundle.js)",
            "headers": [
                { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
            ]
        }
    ],
    "redirects": [
        { "source": "/preview", "destination": "/preview/", "permanent": false },
        { "source": "/v3", "destination": "/v3/", "permanent": false },
        { "source": "/face-baseline", "destination": "/face-baseline/", "permanent": false }
    ],
    "rewrites": [
        { "source": "/face-baseline/", "destination": "/apps/mobile/dist/index.html" },
        { "source": "/face-baseline/(.*)", "destination": "/apps/mobile/dist/$1" },
        { "source": "/brand/(.*)", "destination": "/brand/$1" },
        { "source": "/v3/", "destination": "/apps/preview/v6/index.html" },
        { "source": "/v3/(.*)", "destination": "/apps/preview/v6/$1" },
        { "source": "/preview/", "destination": "/apps/preview/soul-enroll.html" },
        { "source": "/preview/finger", "destination": "/apps/preview/index.html" },
        { "source": "/preview/finger/", "destination": "/apps/preview/index.html" },
        { "source": "/preview/(.*)", "destination": "/apps/preview/$1" },
        { "source": "/", "destination": "/apps/web/index.html" },
        { "source": "/(.*)", "destination": "/apps/web/$1" }
    ]
}
