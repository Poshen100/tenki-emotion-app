{
    "installCommand": "npm install --legacy-peer-deps && cd apps/mobile && npm install --legacy-peer-deps",
    "buildCommand": "cd apps/mobile && npx expo export --platform web --output-dir dist-web",
    "outputDirectory": ".",
    "framework": null,
    "rewrites": [
        { "source": "/preview", "destination": "/apps/preview/index.html" },
        { "source": "/preview/", "destination": "/apps/preview/index.html" },
        { "source": "/preview/(.*)", "destination": "/apps/preview/$1" },
        { "source": "/mobile", "destination": "/apps/mobile/dist-web/index.html" },
        { "source": "/mobile/", "destination": "/apps/mobile/dist-web/index.html" },
        { "source": "/mobile/(.*)", "destination": "/apps/mobile/dist-web/$1" },
        { "source": "/", "destination": "/apps/web/index.html" },
        { "source": "/(.*)", "destination": "/apps/web/$1" }
    ]
}
